# Copie para .env e preencha. O Docker Compose lê este arquivo (env_file: .env).
# Sem NIM_API_KEY o app roda em modo demonstração, com um gerador local.

# --- Modelo de linguagem (NVIDIA NIM, API compatível com OpenAI) ---
# Chave gerada em https://build.nvidia.com (formato nvapi-...)
NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Tempo máximo de espera pela resposta do modelo, em milissegundos
NVIDIA_GENERATION_TIMEOUT_MS=300000
# Registra prompt e resposta bruta do modelo no log do servidor
DEBUG_AI_PROMPT=false

# Limite de gerações com o modelo por IP. Ao exceder, o app mostra a prévia local.
GENERATION_RATE_LIMIT=20
GENERATION_RATE_WINDOW_MS=300000

# --- Texto bíblico ---
# Padrão: Almeida (domínio público) via bible-api.com, sem token.
# BIBLE_API_URL=https://bible-api.com

# NVI, ARA e ACF são traduções protegidas (NVI © Biblica; ARA e ACF © SBB).
# Só habilite se tiver licença de uso. Exige BIBLE_LICENSED_ENABLED=true e um
# token de https://www.abibliadigital.com.br; sem isso o app usa Almeida.
# BIBLE_LICENSED_ENABLED=false
# BIBLE_API_TOKEN=
# ABIBLIA_API_URL=https://www.abibliadigital.com.br/api

# --- Supabase (opcional) ---
# Habilita contas e salvamento na nuvem; sem isso o histórico fica no navegador.
# A chave anon é pública: o acesso aos dados é protegido por RLS.
# Antes de usar, rode supabase/migrations/0001_init_decks.sql no SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Porta do servidor Node (Docker)
PORT=3000
